# Local Titan test workspace (own go.mod, not part of this module)
.titan-workspace/

# Personal workspace config: machine-specific, and not part of the product
.titan/
.wrangler/

# Generated by deploy/sitegen/build-docs.py at publish time. The markdown in
# docs/ is the source; committing the rendered HTML would guarantee the two
# drift and would double every docs diff.
web/zybuu/docs/

# Generated by deploy/sitegen/build-docs.py alongside the public site. Embedded
# into the binary at build time; committing it would double every docs diff.
internal/docsite/site/*
!internal/docsite/site/.keep

# Database credentials generated by deploy/run.sh. Never committed: a password
# in a repository is a password published.
deploy/.db-password
deploy/.db-admin-password

# Demo artefacts are built by deploy/demo/build.sh and published with the
# site; they are large binaries and are not source.
web/zybuu/demo/*.mp4
web/zybuu/demo/*.webm
web/zybuu/demo/*.pptx
web/zybuu/demo/*.jpg
deploy/.demo-secret

# Rendered by deploy/sitegen/build-docs.py from docs/access-policy.md.
web/zybuu/titan/access-policy.html
# Playwright for the demo recording, installed by deploy/demo/build.sh.
deploy/demo/node_modules
deploy/demo/package.json
web/zybuu/demo/series/
deploy/demo/series/node_modules
web/zybuu/media/*.mp4
web/zybuu/media/*.jpg
