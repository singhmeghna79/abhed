# Runs abhed-backup.service nightly. 03:17 UTC, not 03:00: the point of an
# odd minute is not to line up with every other cron job on the same
# provider's shared hardware. Persistent=true runs a missed night at the
# next boot, so a host that was down at 03:17 still gets its backup.
[Unit]
Description=Nightly Abhed console backup

[Timer]
OnCalendar=*-*-* 03:17:00 UTC
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
