<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps the podman machine and the abhed / abhed-db containers up. A user
  agent, not a daemon: the podman machine belongs to the user account and
  its VM runs in that user's session, so this can only start once the user
  has logged in. It runs deploy/cloud/mac-up.sh at login and every two
  minutes; the script exits at once when everything is already running.

  Install (deploy/cloud/mac-always-on.md):
    mkdir -p ~/Library/Logs/abhed
    install -m 644 deploy/cloud/launchd/com.zybuu.abhed.containers.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.zybuu.abhed.containers.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zybuu.abhed.containers</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/abhed/deploy/cloud/mac-up.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ABHED_REPO_DIR</key>
    <string>__HOME__/abhed</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/abhed/containers.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/abhed/containers.log</string>
</dict>
</plist>
